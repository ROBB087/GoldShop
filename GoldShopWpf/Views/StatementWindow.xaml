<Window x:Class="GoldShopWpf.Views.StatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource WindowStatementPreview}"
        Height="920"
        Width="980"
        MinWidth="840"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="{DynamicResource AppFlowDirection}">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="20,20,20,0"
                Padding="24"
                CornerRadius="24"
                Background="#FFF9EC"
                BorderBrush="#F1E0A9"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Image x:Name="LogoImage" Width="64" Height="64" Margin="0,0,12,0" Visibility="Collapsed" />
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ReceiptTitle}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource SubStatementWindow}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>

                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <StackPanel MinWidth="180" Margin="0,0,16,8">
                        <TextBlock Text="{DynamicResource LblFrom}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                        <DatePicker x:Name="FromDate" Margin="0" SelectedDateChanged="OnDateChanged" />
                    </StackPanel>
                    <StackPanel MinWidth="180" Margin="0,0,16,8">
                        <TextBlock Text="{DynamicResource LblTo}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                        <DatePicker x:Name="ToDate" Margin="0" SelectedDateChanged="OnDateChanged" />
                    </StackPanel>
                    <Border MinWidth="250"
                            Margin="0,22,16,8"
                            Padding="14,12"
                            Background="#FFFAF4"
                            BorderBrush="#E7D6AE"
                            BorderThickness="1"
                            CornerRadius="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ShowNotesInTableCheckBox"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          Checked="OnShowNotesChanged"
                                          Unchecked="OnShowNotesChanged" />
                                <TextBlock Text="{DynamicResource LblShowNotesInReceiptTable}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#4F3A08" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="12,0,0,0"
                                    Background="#FFF3D8"
                                    BorderBrush="#E7D6AE"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    ToolTip="{DynamicResource TooltipShowNotesInReceiptTable}"
                                    ToolTipService.InitialShowDelay="150"
                                    ToolTipService.ShowDuration="60000">
                                <materialDesign:PackIcon Kind="InformationOutline"
                                                         Width="16"
                                                         Height="16"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#8A6C00" />
                            </Border>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,18,12,0" Click="OnGenerate" ToolTip="{DynamicResource BtnUpdateDates}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource BtnUpdateDates}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="0,18,0,0" Click="OnPrint" ToolTip="{DynamicResource BtnPrint}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource BtnPrint}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardContainer}" Margin="20">
            <FlowDocumentScrollViewer x:Name="PreviewViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsToolBarVisible="False" />
        </Border>
    </Grid>
</Window>
